# Copy to .env and fill in the first three values. Everything else is optional.
# To set an optional value, uncomment its line.
# Never leave a value blank: a blank value replaces the code's default.
# See CONTRIBUTING.md#2-environment-variables

# Needed for a local run
DATABASE_URL=postgresql://user@/dbname?host=/path/to/pg/socket
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Chat models on another OpenAI-compatible provider. Set both lines:
# CHAT_API_KEY without CHAT_BASE_URL is sent to api.openai.com.
# See CONTRIBUTING.md#pointing-the-chat-models-at-another-provider
# CHAT_BASE_URL=https://api.studio.nebius.com/v1/
# CHAT_API_KEY=

# LangSmith tracing: see CONTRIBUTING.md#2-environment-variables
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ai-legal-tool

# Models: see CONTRIBUTING.md#model-overrides
# ROUTER_MODEL=gpt-4.1
# CONTEXTUALIZER_MODEL=gpt-4.1-mini
# CONVERSATIONAL_MODEL=gpt-4.1-mini
# SYNTHESISER_MODEL=gpt-4.1
# GROUNDING_MODEL=claude-sonnet-4-6
# RETRIEVAL_AGENT_MODEL=gpt-4.1
# MEMORY_EXTRACT_MODEL=gpt-4.1-mini
# EVALS_JUDGE_MODEL=claude-haiku-4-5-20251001
# GOOGLE_API_KEY=
# CORPUS_EMBEDDING_MODEL=text-embedding-3-small
# MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=

# Feature flags and their settings: see CONTRIBUTING.md#2-environment-variables
# CHECKPOINTER=memory
# SEMANTIC_MEMORY_RECALL=on
# SEMANTIC_MEMORY_EXTRACT=on
# SEMANTIC_MEMORY_PRUNE=on
# AGENTIC_RETRIEVAL=on
# RETRIEVAL_RECURSION_LIMIT=6
# FOLLOW_REFERENCES_ENABLED=on
# REFERENCE_GRAPH_ENABLED=on
# REFERENCE_GRAPH_COMPARISON_ENABLED=on
# REFERENCE_GRAPH_ROOT=data/reference_graph

# Corpus and Citation Receipts: see CONTRIBUTING.md#2-environment-variables
# CORPUS_RETRIEVAL_MODE=dual
# CORPUS_MANIFEST_PATH=data/pdfs/manifest.json
# CORPUS_LOCAL_ROOT=data/pdfs
# CORPUS_SIDECAR_ROOT=data/corpus/sidecars
# CORPUS_CDN_BASE_URL=https://statutes.example.com
# RECEIPT_DELIVERY_MODE=auto
# RECEIPT_EVIDENCE_MAX_CHARS=500

# Evals: see CONTRIBUTING.md#running-evals
# EVALS_DATABASE_URL=postgresql://user@/ai_legal_tool_evals?host=/path/to/pg/socket
# BM_LANGID_MODEL_REPO=mesolitica/fasttext-language-detection-bahasa-en
# BM_LANGID_MODEL_FILE=fasttext.ftz

# History token budget: see CONTRIBUTING.md#tuning-the-history-token-budget
# MAX_HISTORY_TOKENS=4000

# Knowledge base build: see CONTRIBUTING.md#4-build-the-knowledge-base-one-time-1-hour
# DOWNLOAD_CONCURRENCY=8

# corpus upload: see CONTRIBUTING.md#citation-receipt-assets-and-verification
# CORPUS_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
