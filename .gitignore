# HTTP cache
data/cache/

# PDF downloads (large binaries, regenerable from metadata). Keep the extraction
# corpus ignored except for the manifest, receipt pilots, and explicitly acquired
# content-addressed statutory snapshot objects.
data/pdfs/*
!data/pdfs/manifest.json
!data/pdfs/en/
data/pdfs/en/*
!data/pdfs/en/56.pdf
!data/pdfs/en/265.pdf
!data/pdfs/en/574.pdf
!data/pdfs/en/709.pdf
!data/pdfs/en/777.pdf
!data/pdfs/objects/
# Step 3 writes every downloaded PDF here, ~365 MB the pipeline regenerates in
# seconds. Ignore the bulk and re-include each deliberately acquired snapshot
# by name, the way data/pdfs/en/ above does. Matching *.pdf rather than ** lets
# git descend into the sha256/ directories, which a re-include needs.
data/pdfs/objects/**/*.pdf
!data/pdfs/objects/sha256/1e/e6/1ee65655aedadc7d1ea2e47526036106149835583d246e61d3de3d10749e1b95.pdf
!data/pdfs/objects/sha256/6e/f0/6ef0ba72dc9c149c474d7989b8c3b39168c753472d11a64d720bd227e12a3bf7.pdf
!data/pdfs/objects/sha256/96/b5/96b5741acff0fedda7f6188aa7b86c21d335045bb7dbb613b60ab4b894e537ca.pdf
!data/pdfs/objects/sha256/aa/eb/aaeb175a7c6986b6d535da37680c05535597c09ec0f5813233ec779c986f7caa.pdf
!data/pdfs/objects/sha256/f9/23/f9235f48a1843e426c4f2ee4703d7573a87bfcc1332720134f2cecdc9217eef8.pdf

# Step 2 dumps an Act's raw HTML next to its metadata when the timeline parses
# empty, so there is something to inspect. It is a debugging artifact, not
# corpus data, and it lands in the same directory the metadata is tracked from.
data/acts_metadata/*_debug.html

# Corpus extraction bundles and coordinate sidecars are regenerated by
# `python -m corpus shadow-extract`. Keep the five repaired pilot artifacts for
# local compatibility/smoke tests; full-corpus outputs are uploaded immutably.
data/corpus/extractions/*
data/corpus/sidecars/*


# Logs
scraper.log

evals/results*.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Environment variables
.env
.env.*

# MCP config (contains API keys)
.mcp.json

# IDE
.DS_Store

evals/review-checklist.md

# Reference-graph builds are review candidates until every edge has a human PDF
# receipt decision. Only their per-snapshot .work directories are generated.
data/reference_graph/**/.work/

# Vercel
.vercel

# CodeGraph index (regenerated locally by the codegraph indexer)
.codegraph/
